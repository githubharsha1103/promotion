# Copy to .env and fill in values when needed. Never commit real credentials.
APP_NAME=MTProto Promotion
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
CONTROL_BOT_TOKEN=
ADMIN_ID=

DATA_DIR=data
SESSIONS_DIR=data/sessions
RECORDS_DIR=data/records
MEDIA_DIR=data/media
STICKERS_DIR=data/media/stickers
IMAGES_DIR=data/media/images
VIDEOS_DIR=data/media/videos
DOCUMENTS_DIR=data/media/documents
EXPORTS_DIR=data/exports
BACKUPS_DIR=data/backups
BACKUP_STAGING_DIR=data/backups/.staging
LOGS_DIR=logs
APPLICATION_LOGS_DIR=logs/application
TELEGRAM_LOGS_DIR=logs/telegram
